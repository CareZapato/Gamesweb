# Copia este archivo como ".env" en la raíz del repositorio para cambiar la configuración del
# servidor de juego. No contiene secretos: el proyecto no usa credenciales ni base de datos.

# Puerto HTTP/WebSocket del servidor de juego (matchmaking + salas + cliente compilado).
PORT=2567

# Interfaz de escucha. 0.0.0.0 = accesible desde la red local; 127.0.0.1 = solo esta máquina.
HOST=0.0.0.0

# Orígenes de navegador permitidos (separados por comas). Vacío = se acepta cualquier origen
# (cómodo en desarrollo y LAN). En producción indica tu dominio, p. ej.:
# ALLOWED_ORIGINS=https://juego.ejemplo.com
ALLOWED_ORIGINS=

# Latencia artificial de ida y vuelta en ms, solo para pruebas de red. 0 = desactivada.
SIMULATE_LATENCY_MS=0

# Carpeta con el cliente compilado que el servidor sirve como estático (por defecto client/dist).
# STATIC_DIR=/ruta/a/client/dist
